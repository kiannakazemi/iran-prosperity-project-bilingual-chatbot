# ────────────────────────────────────────────────────────────────────
#  IPP Assistant — environment template
#
#  Copy to .env in this directory and fill in your own keys:
#     Windows PowerShell:  Copy-Item .env.example .env
#     macOS / Linux:       cp .env.example .env
#
#  .env is gitignored. Never commit it.
#  Loaded via dotenv.find_dotenv(usecwd=True), so any working directory works.
# ────────────────────────────────────────────────────────────────────

# ── Required to serve queries ───────────────────────────────────────

# Cohere — embeddings (embed-multilingual-v3.0) and reranking (rerank-v3.5).
# Used by indexing/embedding/cohere_embed.py and
# indexing/retrieval/cohere_rerank.py. https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Google Gemini — answer generation (gemini-3.5-flash-lite) and short helper
# completions (gemini-2.5-flash). One key serves both models.
# Used by chatbot/engine.py. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Optional ────────────────────────────────────────────────────────

# Qwen via Alibaba DashScope. Needed only to (a) regenerate chunk summaries
# in indexing/chunking/chunking.py, or (b) run the Qwen arm of the evaluation
# harness. Either variable name works — the code checks QWEN_API_KEY first,
# then falls back to DASHSCOPE_API_KEY.
# Not required to run the chatbot.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
